# Local-only data. `data/hawks/user-entries/` is NOT listed on purpose:
# four server routes read it through `process.cwd()`, so Next traces those
# 59 files (236K) into the function manifest and the upload fails without them.
data/hawks/candles/
data/parquet/
playwright-report/
test-results/
blob-report/
e2e/
docs/
scripts/

# Caches
.next/cache/
.turbo/
.swc/

# Test / lint configs
playwright.config.ts
vitest.config.ts
eslint.config.mjs
eslint.config.strict.mjs
eslint-rules/

# Source maps already uploaded to Sentry — see next.config.ts sourcemaps.deleteSourcemapsAfterUpload
*.map
