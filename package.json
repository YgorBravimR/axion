{
	"name": "axion",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.2.2",
	"scripts": {
		"dev": ": >> /tmp/axion-dev.log && next dev --turbopack -p ${PORT:-3011} 2>&1 | tee /tmp/axion-dev.log",
		"dev-nc": "rm -rf apps/.next && : >> /tmp/axion-dev.log && next dev --turbopack -p ${PORT:-3011} 2>&1 | tee /tmp/axion-dev.log",
		"build": "next build --turbopack",
		"start": "next start -p ${PORT:-3011}",
		"lint": "eslint",
		"lint:strict": "eslint --config eslint.config.strict.mjs && pnpm i18n:check",
		"i18n:check": "tsx scripts/check-i18n-keys.ts",
		"check:dead-axes": "tsx scripts/check-dead-axes.ts",
		"db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
		"db:migrate": "tsx scripts/run-migrations.ts",
		"db:push": "drizzle-kit push --config ./drizzle.config.ts",
		"db:seed": "tsx scripts/seed.ts",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:debug": "playwright test --debug",
		"test:report": "playwright show-report",
		"test:clean": "rm -rf playwright-report test-results blob-report e2e/.auth/user.json",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"test:lint-rules": "node --test eslint-rules/tests/*.test.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.100.1",
		"@auth/drizzle-adapter": "1.11.2",
		"@aws-sdk/client-s3": "3.1058.0",
		"@google-cloud/vision": "5.3.6",
		"@hookform/resolvers": "5.4.0",
		"@neondatabase/serverless": "1.1.0",
		"@radix-ui/react-alert-dialog": "1.1.15",
		"@radix-ui/react-checkbox": "1.3.3",
		"@radix-ui/react-dialog": "1.1.15",
		"@radix-ui/react-dropdown-menu": "2.1.16",
		"@radix-ui/react-label": "2.1.8",
		"@radix-ui/react-popover": "1.1.15",
		"@radix-ui/react-radio-group": "1.3.8",
		"@radix-ui/react-scroll-area": "1.2.10",
		"@radix-ui/react-select": "2.2.6",
		"@radix-ui/react-separator": "1.1.8",
		"@radix-ui/react-slot": "1.2.4",
		"@radix-ui/react-switch": "1.2.6",
		"@radix-ui/react-tabs": "1.1.13",
		"@radix-ui/react-tooltip": "1.2.8",
		"@react-pdf/renderer": "4.5.1",
		"@sentry/nextjs": "10.55.0",
		"@tanstack/react-table": "8.21.3",
		"@tanstack/react-virtual": "3.14.1",
		"bcryptjs": "3.0.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-fns": "4.4.0",
		"dotenv": "17.4.2",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
		"groq-sdk": "1.2.1",
		"html-to-image": "1.11.13",
		"idb": "8.0.3",
		"input-otp": "1.4.2",
		"lightweight-charts": "5.2.0",
		"lucide-react": "1.17.0",
		"next": "16.2.7",
		"next-auth": "5.0.0-beta.30",
		"next-intl": "4.13.0",
		"next-themes": "0.4.6",
		"openai": "6.41.0",
		"pdf-parse": "2.4.5",
		"postgres": "3.4.9",
		"posthog-js": "1.378.1",
		"react": "19.2.7",
		"react-colorful": "5.7.0",
		"react-day-picker": "10.0.1",
		"react-dom": "19.2.7",
		"react-hook-form": "7.77.0",
		"recharts": "3.8.1",
		"resend": "6.12.4",
		"tailwind-merge": "3.6.0",
		"tesseract.js": "7.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@commitlint/cli": "21.0.2",
		"@commitlint/config-conventional": "21.0.2",
		"@eslint-react/eslint-plugin": "5.8.10",
		"@eslint/js": "10.0.1",
		"@next/eslint-plugin-next": "16.2.7",
		"@playwright/test": "1.60.0",
		"@tailwindcss/postcss": "4.3.0",
		"@types/node": "25.9.1",
		"@types/react": "19.2.16",
		"@types/react-dom": "19.2.3",
		"@types/ws": "8.18.1",
		"@vitest/coverage-v8": "4.1.8",
		"eslint": "10.4.1",
		"eslint-plugin-better-tailwindcss": "4.5.0",
		"eslint-plugin-drizzle": "0.2.3",
		"eslint-plugin-import-x": "4.16.2",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react-hooks": "7.1.1",
		"fake-indexeddb": "6.2.5",
		"husky": "9.1.7",
		"knip": "6.15.0",
		"lint-staged": "17.0.7",
		"prettier": "3.8.3",
		"prettier-plugin-tailwindcss": "0.8.0",
		"tailwindcss": "4.3.0",
		"tsx": "4.22.4",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.1",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "4.1.8",
		"ws": "8.21.0"
	}
}
